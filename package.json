{
  "name": "eerie-echoes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c red,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite frontend",
    "dev:server": "nodemon --watch backend --ext ts --ignore backend/tests --exec tsx backend/index.ts",
    "start": "tsx backend/index.ts",
    "build": "vite build frontend",
    "build:dev": "vite build frontend --mode development",
    "preview": "vite preview frontend",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p frontend/tsconfig.app.json",
    "lint": "eslint --config frontend/eslint.config.js frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "vitest run --config backend/vitest.config.ts",
    "test:frontend": "vitest run --root frontend",
    "test:watch": "vitest --config backend/vitest.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "@vercel/functions": "3.11.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "framer-motion": "^12.34.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.462.0",
    "mongoose": "^9.7.1",
    "multer": "^2.2.0",
    "next-themes": "^0.3.0",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.6",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
