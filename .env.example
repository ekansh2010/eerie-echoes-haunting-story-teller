# ---- Core ----
NODE_ENV=development            # development | production | test
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/eerie_echoes
# REQUIRED in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Public URL of the frontend (used in verification/reset email links)
FRONTEND_URL=http://localhost:3000
# Comma-separated allowed origins if the frontend is on a different domain ("*" = any).
# Leave empty when frontend and API share a domain (Vercel / single server).
CORS_ORIGIN=

# ---- Email (SMTP). Without it: dev uses an Ethereal test inbox, production skips sending. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Eerie Echoes" <noreply@eerieechoes.com>

# ---- Seeding ----
# Admin is created on first boot if no admin exists.
ADMIN_USERNAME=DarkScribe
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Demo users/stories (default: true in dev, false in production). Only seeds an EMPTY stories collection.
SEED_DEMO_DATA=

# ---- Ops ----
RATE_LIMIT_ENABLED=true
TRUST_PROXY=1                   # number of reverse proxies in front of the app
LOG_LEVEL=info                  # debug | info | warn | error | silent

# ---- AI story covers ----
# Claude reads each new story and describes its key scene; Pollinations renders it; the image is stored in MongoDB.
# Without a key, covers are generated from the title + opening lines instead.
ANTHROPIC_API_KEY=
AI_COVERS_ENABLED=true
AI_COVER_MODEL=claude-opus-5-5
